# Copy to .env beside docker-compose.yml. Never commit real keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Backend only: required for game snapshots/history; never put in Expo mobile.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Backend only. Create this in RevenueCat; never expose it to the mobile app.
REVENUECAT_SECRET_API_KEY=sk_YOUR_REVENUECAT_SECRET_KEY

