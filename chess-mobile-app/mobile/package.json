{
  "name": "chess-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "react-native run-ios",
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "build:android:cloud": "npm exec --yes --package=eas-cli@26 -- eas build --platform android --profile preview",
    "build:android:dev": "npm exec --yes --package=eas-cli@26 -- eas build --platform android --profile development",
    "test": "jest",
    "lint": "eslint .",
    "clean": "cd android && ./gradlew clean && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.7",
    "chess.js": "^1.0.0-beta.8",
    "expo": "~50.0.21",
    "expo-dev-client": "~3.3.12",
    "expo-secure-store": "~12.8.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "2.14.1",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-svg": "14.1.0",
    "socket.io-client": "^4.7.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/runtime": "^7.23.9",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.45",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "react-test-renderer": "18.2.0",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "jest": {
    "preset": "react-native"
  }
}
