# Public backend URL used by the app. Use a LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8082

# Public Supabase Auth config; never put the secret/service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Public RevenueCat Android SDK key. Safe to embed; this is not a secret key.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_REVENUECAT_ANDROID_PUBLIC_KEY
